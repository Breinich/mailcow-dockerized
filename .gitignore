# ==========================================
# 1. SENSITIVE SECRETS (NEVER COMMIT THESE)
# ==========================================
mailcow.conf
mailcow.conf_backup
*.pem
*.key
*.crt
data/assets/ssl/*
data/conf/rspamd/dkim/*
data/conf/sogo/*.creds
data/conf/phpfpm/sogo-sso/sogo-sso.pass
data/conf/rspamd/override.d/worker-controller-password.inc
.env

# ==========================================
# 2. PERSISTENT DATA & LOGS (TOO HEAVY)
# ==========================================
data/mysql/*
data/vmail/*
data/redis/*
data/rspamd/*
data/web/templates/cache/*
**/logs/*
*.log
*.db

# ==========================================
# 3. UPSTREAM APP CODE (ALREADY ON GITHUB)
# ==========================================
data/web/*
data/Dockerfiles/*
data/assets/*

# ==========================================
# 4. TEMPORARY FILES & BACKUPS
# ==========================================
*.bak
*.bak.*
*.orig
*.swp
.DS_Store
.idea/
.vscode/

# ==========================================
# 5. WHITELIST (THE STUFF YOU ACTUALLY WANT)
# ==========================================
# These '!' symbols tell Git: "Even if I ignored the parent folder, keep THESE."
!data/conf/postfix/extra.cf
!data/conf/dovecot/extra.conf
!data/conf/rspamd/local.d/
!data/conf/rspamd/override.d/
!docker-compose.override.yml
!mailcow.conf.example
data/conf/acme/dns-01.conf
data/conf/rspamd/local.d/fuzzy_check.conf
data/conf/rspamd/local.d/redis.conf
# Ignore SQL configuration files containing DB passwords
data/conf/postfix/sql/*
data/conf/dovecot/sql/*

data/conf/dovecot/dovecot-master.passwd
data/conf/dovecot/dovecot-master.userdb
